# PostgreSQL
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"

# MTN MoMo Collection API
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_API_USER="your-mtn-api-user"
MTN_MOMO_API_KEY="your-mtn-api-key"
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY="your-collection-primary-subscription-key"
MTN_MOMO_CALLBACK_URL="https://your-domain.example/api/payments/webhook"

# MTN MoMo Disbursements (seller payouts)
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY="your-disbursement-primary-subscription-key"
