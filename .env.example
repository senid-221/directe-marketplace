# Neon PostgreSQL — set the real value only in your local .env / deployment environment
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/directe_database?sslmode=require&channel_binding=require"
JWT_SECRET="replace-with-a-long-random-secret"

# Flutterwave payments
FLW_PUBLIC_KEY="your-flutterwave-public-key"
FLW_SECRET_KEY="your-flutterwave-secret-key"
FLW_SECRET_HASH="your-flutterwave-webhook-secret-hash"
NEXT_PUBLIC_APP_URL="https://your-domain.example"
